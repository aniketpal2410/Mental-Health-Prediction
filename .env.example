# ==============================================================================
# MindCare - Environment Configuration Template
# Copy this file to .env and customize the values for your environment.
# ==============================================================================

# Database Connection (PostgreSQL via psycopg v3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mindcare

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed CORS Origins (comma-separated list of client URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Trained Machine Learning Model Path (defaults to models/Mental_Health_Model.pkl)
MODEL_PATH=models/Mental_Health_Model.pkl
